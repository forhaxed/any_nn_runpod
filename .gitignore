# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/

# Test and type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# ── Secrets ─────────────────────────────────────────────────────────
# RUNPOD_API_KEY lives here. It never belongs in a commit, and it never
# goes into a pod's environment either -- see cloud/lifecycle.py.
.env
.env.*
!.env.example

# ── Built environments ──────────────────────────────────────────────
# `run.py local` builds the recipe's venv under here. Gigabytes, and
# rebuildable from remote/anr.toml at any time.
.anr/

# ── What runs produce ───────────────────────────────────────────────
# TensorBoard events, checkpoints and lock files. Every example and every
# project writes an out/ next to itself.
out/
output/
examples/**/out/

# ── What runs consume ───────────────────────────────────────────────
# Downloaded datasets and anything heavy an example pulls or produces.
# examples/cifar fetches ~170 MB per side on first run and re-fetches on
# demand, so none of it is worth keeping.
#
# Scoped to examples/ deliberately: a blanket *.pt would also swallow a test
# fixture someone adds later, and silently ignoring a file that was meant to
# be committed is a nastier problem than a large one that was not.
examples/**/data/
examples/**/*.tar.gz
examples/**/*.safetensors
examples/**/*.ckpt
examples/**/*.pt
examples/**/*.pth
examples/**/*.bin

# ── OS ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
[Dd]esktop.ini
*.lnk
