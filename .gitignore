# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/

# Test and type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# ── Secrets ─────────────────────────────────────────────────────────
# RUNPOD_API_KEY lives here. It never belongs in a commit, and it never
# goes into a pod's environment either -- see cloud/lifecycle.py.
.env
.env.*
!.env.example

# ── Built environments ──────────────────────────────────────────────
# `run.py local` builds the recipe's venv under here. Gigabytes, and
# rebuildable from remote/anr.toml at any time.
.anr/

# ── What runs produce ───────────────────────────────────────────────
# TensorBoard events, checkpoints and lock files. Anything driven from a
# checkout writes an out/ next to itself.
out/
output/

# ── OS ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
[Dd]esktop.ini
*.lnk
